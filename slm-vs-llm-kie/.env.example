# Copy to .env and fill in. .env is gitignored — never commit real keys.

# === ACTIVE large arm ===
# AWS Bedrock (GPT-OSS-120B, Qwen3-235B, Llama-3.1-405B). Create a Bedrock API key:
# Console -> Amazon Bedrock -> API keys. Enable model access first (Model access page).
AWS_BEARER_TOKEN_BEDROCK=<your-bedrock-api-key>
AWS_REGION=us-west-2
# (Alternative to the API key: standard IAM creds via the default chain.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Google Generative Language API (Gemma-3-27B). Google AI Studio -> Get API key.
GEMINI_API_KEY=<your-gemini-api-key>

# === Retired / optional ===
# Azure OpenAI (GPT models — the frontier-llm slot)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>

# Azure AI Foundry serverless (Phi/Mistral/Llama — phi4-mini, mistral-7b, large-open-llm)
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/models
AZURE_FOUNDRY_API_KEY=<your-azure-foundry-key>

# Optional: only if you switch api.provider to anthropic/openai in config.yaml
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
