# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Azure OpenAI (used for the two API models: frontier-llm, large-open-llm)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>

# Optional: only if you switch api.provider to anthropic/openai in config.yaml
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
